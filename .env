# 浏览器标签页标题
  VITE_GLOB_APP_TITLE = MyAdmin

  # 本地运行端口号
  VITE_PORT = 8848

  # 启动时自动打开浏览器
  VITE_OPEN = true

  # 开启 devTools 调试（开发时设为 true，生产时 false）
  VITE_DEVTOOLS = false

  # 打包后是否生成包分析文件（查看各模块体积）
  VITE_REPORT = false
  # VITE_REPORT = true
  # 开启 CodeInspector 调试（浏览器里点页面元素直接跳转到对应源码）
  VITE_CODEINSPECTOR = false
