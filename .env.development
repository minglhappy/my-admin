 # 环境标识
  VITE_USER_NODE_ENV = development

  # 公共路径（部署在域名根路径就是 /，部署在子目录就是 /xxx/）
  VITE_PUBLIC_PATH = /

  # 路由模式：hash（带 # 号）或 history（不带 # 号）
  VITE_ROUTER_MODE = hash

  # 生产环境是否启用 PWA（开发时关闭，省性能）
  VITE_PWA = false

  # 是否在打包时删除 console.log 和 debugger
  VITE_DROP_CONSOLE = false

  # API 地址（空字符串 = 走 Vite 代理）
  VITE_API_URL = http://localhost:3000

  # 跨域代理（开发环境用，格式：[[前缀, 目标地址]]）
  # 现在先注释，后面配 Mock 时会用到
  # VITE_PROXY = [["/api","http://localhost:3000"]]
